{
  "name": "@netwin/maple",
  "version": "0.5.1",
  "description": "A secure JavaScript interpreter written in TypeScript",
  "keywords": [
    "interpreter",
    "isolation",
    "javascript-interpreter",
    "sandbox",
    "scripting",
    "untrusted-code"
  ],
  "homepage": "https://github.com/NetWin/maple/tree/master/packages/maple#readme",
  "bugs": {
    "url": "https://github.com/NetWin/maple/issues"
  },
  "license": "MIT",
  "author": "NetWin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NetWin/maple.git",
    "directory": "packages/maple"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "acorn": "^8.19.0"
  },
  "engines": {
    "node": ">=22"
  }
}
